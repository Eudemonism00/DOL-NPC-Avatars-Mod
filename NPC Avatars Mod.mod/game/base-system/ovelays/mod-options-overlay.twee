:: NPCAvatarsMod_Options [widget]

<<widget "optionscharacterstyles">>
	<<setupOptions>>
	<div id="characterStylesContainer">
		<<optionscharacterstylesContent>>
	</div>
<</widget>>

<<widget "optionscharacterstylesContent">>
	<<set _isZh to CharStyleConfig.isZh()>>

	<div class="settingsGrid">
		<div class="settingsHeader options">
			<span class="gold"><<print _isZh ? "NPC头像增添模组" : "NPC Avatars Mod">></span>
		</div>

		<!-- 循环输出每个角色的单选框组 -->
		<<for _i to 0; _i lt CharStyleConfig.characters.length; _i++>>
			<<set _char to CharStyleConfig.characters[_i]>>
			<<set _effectiveStyle to CharStyleConfig.getStyle(_char.id)>>
			<<set _safeRadioName to "avatar_radio_" + _char.id.replace(/\s+/g, '_')>>

			<div class="settingsToggleItem">
				<span class="gold"><<print _isZh ? _char.nameZh : _char.nameEn>>:</span>
				<<for _sIdx to 0; _sIdx lt _char.supported.length; _sIdx++>>
					<<set _styleKey to _char.supported[_sIdx]>>
					<<set _styleData to CharStyleConfig.styles[_styleKey]>>
					<<if _sIdx gt 0>> | <</if>>
					<label>
						<<if _effectiveStyle is _styleKey>>
							<input type="radio" 
								@name="_safeRadioName" 
								@value="_styleKey" 
								checked="checked" 
								@data-char="_char.id" 
								onchange="CharStyleConfig.setStyle(this.dataset.char, this.value)" />
						<<else>>
							<input type="radio" 
								@name="_safeRadioName" 
								@value="_styleKey" 
								@data-char="_char.id" 
								onchange="CharStyleConfig.setStyle(this.dataset.char, this.value)" />
						<</if>>
						<<print _styleData.name>>
					</label>
				<</for>>
			</div>
		<</for>>
	</div>
<</widget>>
