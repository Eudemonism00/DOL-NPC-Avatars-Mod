:: NPCAvatarsMod_Maplebirch
<<switch _npc>>
	<<case "Night Monster">>
        <<if ($settings.monsterChance gte random(1, 100) and ($hallucinations gte 1 or !$settings.monsterHallucinationsOnly)) or $nightmonstermonster is 2>>
		    <img class="icon" @src="'img/misc/icon/social/default/nm/nm_' + C.npc['Night Monster'].pronoun + '.png'">
        <<else>>
            <img class="icon" src="img/misc/icon/social/default/nm/nm_beast.png">
        <</if>>
<</switch>>

:: NPCAvatarsMod_Mimic_Maplebirch
<<if $wraith.mimic isnot "">>
    <<switch $wraith.mimic>>
        /* 未来画了拟态图再补，没画直接自动用原版 */
        <<default>>
            <<include "NPCAvatarsMod_Mimic_Default">>
    <</switch>>
<</if>>