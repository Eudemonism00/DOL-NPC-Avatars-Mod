            <<elseif C.npc.Morgan.dom lte $npcdomlow>>
                <img class="icon" @src="'img/misc/icon/social/default/morgan/morgan_inspiring_' + C.npc.Morgan.pronoun + '.png'">
            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/morgan/morgan_delightful_' + C.npc.Morgan.pronoun + '.png'">
            <</if>>
        <<elseif C.npc.Morgan.love lte $npclovelow>>
            <img class="icon" @src="'img/misc/icon/social/default/morgan/morgan_terrible_' + C.npc.Morgan.pronoun + '.png'">
        <<else>>
            <<if C.npc.Morgan.dom gte $npcdomhigh>>
                <img class="icon" @src="'img/misc/icon/social/default/morgan/morgan_cute_' + C.npc.Morgan.pronoun + '.png'">
            <<elseif C.npc.Morgan.dom lte $npcdomlow>>
                <img class="icon" @src="'img/misc/icon/social/default/morgan/morgan_lookup_' + C.npc.Morgan.pronoun + '.png'">
            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/morgan/morgan_default_' + C.npc.Morgan.pronoun + '.png'">
            <</if>>
        <</if>>
    <<case River>>
        <<if C.npc.River.love gte 40>>
