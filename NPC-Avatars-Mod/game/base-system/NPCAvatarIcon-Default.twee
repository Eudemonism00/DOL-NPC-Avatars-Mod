            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/wren/wren_default_' + C.npc.Wren.pronoun + '.png'">
            <</if>>
        <</if>>
    <<case Zephyr>>
        <<if C.npc.Zephyr.love gte 50>>
            <img class="icon" @src="'img/misc/icon/social/default/zephyr/zephyr_delightful_' + C.npc.Zephyr.pronoun + '.png'">
        <<elseif C.npc.Zephyr.love lte $npclovelow>>
