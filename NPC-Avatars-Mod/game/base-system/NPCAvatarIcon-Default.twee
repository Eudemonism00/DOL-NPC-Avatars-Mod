        <<else>>
            <<if C.npc.Sirris.love gte 25>>
                <img class="icon" @src="'img/misc/icon/social/default/sirris/sirris_fine_' + C.npc.Sirris.pronoun + '.png'">
            <<else>>
                <<if $adultshopintro>>
                    <img class="icon" @src="'img/misc/icon/social/default/sirris/sirris_help_' + C.npc.Sirris.pronoun + '.png'">
                <<else>>
                    <img class="icon" @src="'img/misc/icon/social/default/sirris/sirris_default_' + C.npc.Sirris.pronoun + '.png'">
                <</if>>
            <</if>>
        <</if>>
    <<case Winter>>
        <<if C.npc.Winter.love gte 50>>
            <img class="icon" @src="'img/misc/icon/social/default/winter/winter_delightful_' + C.npc.Winter.pronoun + '.png'">
        <<elseif C.npc.Winter.love gte 25>>
            <img class="icon" @src="'img/misc/icon/social/default/winter/winter_lookup_' + C.npc.Winter.pronoun + '.png'">
        <<elseif C.npc.Winter.love lte $npclovelow>>
            <img class="icon" @src="'img/misc/icon/social/default/winter/winter_terrible_' + C.npc.Winter.pronoun + '.png'">
        <<else>>
            <img class="icon" @src="'img/misc/icon/social/default/winter/winter_default_' + C.npc.Winter.pronoun + '.png'">
        <</if>>
    <<case Niki>>
        <<if C.npc.Niki.love gte 25>>
            <img class="icon" @src="'img/misc/icon/social/default/niki/niki_delightful_' + C.npc.Niki.pronoun + '.png'">
        <<else>>
            <img class="icon" @src="'img/misc/icon/social/default/niki/niki_default_' + C.npc.Niki.pronoun + '.png'">
        <</if>>
    <<case Quinn>>
        <<if C.npc.Quinn.love gte 25>>
            <img class="icon" @src="'img/misc/icon/social/default/quinn/quinn_interest_' + C.npc.Quinn.pronoun + '.png'">
        <<elseif C.npc.Quinn.love lte $npclovelow>>
            <img class="icon" @src="'img/misc/icon/social/default/quinn/quinn_terrible_' + C.npc.Quinn.pronoun + '.png'">
        <<else>>
            <<if $town_projects.diving gte 3>>
                <img class="icon" @src="'img/misc/icon/social/default/quinn/quinn_necklace_' + C.npc.Quinn.pronoun + '.png'">
            <<elseif C.npc.Quinn.lust gte 20>>
                <img class="icon" @src="'img/misc/icon/social/default/quinn/quinn_mind_' + C.npc.Quinn.pronoun + '.png'">
            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/quinn/quinn_default_' + C.npc.Quinn.pronoun + '.png'">
            <</if>>
        <</if>>
    <<case Remy>>
        <div class="icon-container">
            <<if $remy_seen is "manor" and $location is "estate" and $npc.includes("Remy")>>
                <img class="icon" @src="'img/misc/icon/social/default/remy/remy_mask_' + C.npc.Remy.pronoun + '.png'">
            <<elseif C.npc.Remy.love gte 50>>
                <<if $remy_mask is 1>>
                    <img class="icon infront" src="img/misc/icon/social/default/remy/remy_mask_low.png">
                <</if>>
                <<if C.npc.Remy.dom gte 25>>
                    <img class="icon" @src="'img/misc/icon/social/default/remy/remy_adorable_' + C.npc.Remy.pronoun + '.png'">
                <<elseif C.npc.Remy.dom lte $npcdomlow>>
                    <img class="icon" @src="'img/misc/icon/social/default/remy/remy_inspiring_' + C.npc.Remy.pronoun + '.png'">
                <<else>>
                    <img class="icon" @src="'img/misc/icon/social/default/remy/remy_delightful_' + C.npc.Remy.pronoun + '.png'">
                <</if>>
            <<elseif C.npc.Remy.love lte $npclovelow>>
                <<if $remy_mask is 1>>
                    <img class="icon infront" src="img/misc/icon/social/default/remy/remy_mask_high.png">
                <</if>>
                <img class="icon" @src="'img/misc/icon/social/default/remy/remy_terrible_' + C.npc.Remy.pronoun + '.png'">
            <<else>>
                <<if $remy_mask is 1>>
                    <img class="icon infront" src="img/misc/icon/social/default/remy/remy_mask_high.png">
                <</if>>
                <<if C.npc.Remy.dom gte $npcdomhigh>>
                    <img class="icon" @src="'img/misc/icon/social/default/remy/remy_cute_' + C.npc.Remy.pronoun + '.png'">
                <<elseif C.npc.Remy.dom lte $npcdomlow>>
                    <img class="icon" @src="'img/misc/icon/social/default/remy/remy_lookup_' + C.npc.Remy.pronoun + '.png'">
                <<else>>
                    <img class="icon" @src="'img/misc/icon/social/default/remy/remy_default_' + C.npc.Remy.pronoun + '.png'">
                <</if>>
            <</if>>
        </div>
    <<case Wren>>
        <<if $location is "prison" and $prison_wren_intro isnot 1>>
            <img class="icon" @src="'img/misc/icon/social/default/wren/wren_prison_' + C.npc.Wren.pronoun + '.png'">
        <<elseif C.npc.Wren.love gte 35>>
            <<if C.npc.Wren.dom gte 25>>
                <img class="icon" @src="'img/misc/icon/social/default/wren/wren_adorable_' + C.npc.Wren.pronoun + '.png'">
            <<else>>
