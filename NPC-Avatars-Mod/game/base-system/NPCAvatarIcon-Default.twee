        <<else>>
            <img class="icon" @src="'img/misc/icon/social/default/sam/sam_default_' + C.npc.Sam.pronoun + '.png'">
        <</if>>
    <<case Sirris>>
        <<if $adultshopunlocked>>
            <<if C.npc.Sirris.love gte 50>>
                <<if $sydneyromance gte 1 and $sydneySeen?.includes("parent") and pregnancyCompatible("Sydney") and $rng gte 51>>
                    <img class="icon" @src="'img/misc/icon/social/default/sirris/sirris_grandkids_' + C.npc.Sirris.pronoun + '.png'">
                <<else>>
                    <img class="icon" @src="'img/misc/icon/social/default/sirris/sirris_delightful_' + C.npc.Sirris.pronoun + '.png'">
                <</if>>
            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/sirris/sirris_delightful_' + C.npc.Sirris.pronoun + '.png'">
            <</if>>
        <<elseif C.npc.Sirris.love lte $npclovelow>>
