                <img class="icon" @src="'img/misc/icon/social/default/wren/wren_cheat_' + C.npc.Wren.pronoun + '.png'">
            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/wren/wren_terrible_' + C.npc.Wren.pronoun + '.png'">
            <</if>>
        <<else>>
            <<if C.npc.Wren.dom gte 25>>
