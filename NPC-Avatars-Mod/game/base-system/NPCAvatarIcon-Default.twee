        <<else>>
            <img class="icon" @src="'img/misc/icon/social/default/zephyr/zephyr_default_' + C.npc.Zephyr.pronoun + '.png'">
        <</if>>
<</switch>>

:: NPCAvatarsMod-Mimic-Default
<<if $wraith.mimic isnot "">>
    <<switch $wraith.mimic>>
        <<case Robin>>
            <<if $wraith.state is "haunt">>
                <img class="icon" @src="'img/misc/icon/social/default/robin/robin_iwr_' + C.npc.Robin.pronoun + '.png'">
            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/robin/robin_iwb_' + C.npc.Robin.pronoun + '.png'">
            <</if>>
        <<case Kylar>>
            <<if $wraith.state is "haunt">>
                <img class="icon" @src="'img/misc/icon/social/default/kylar/kylar_iwr_' + C.npc.Kylar.pronoun + '.png'">
            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/kylar/kylar_iwb_' + C.npc.Kylar.pronoun + '.png'">
            <</if>>
        <<case Eden>>
            <<if $wraith.state is "haunt">>
                <img class="icon" @src="'img/misc/icon/social/default/eden/eden_iwr_' + C.npc.Eden.pronoun + '.png'">
            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/eden/eden_iwb_' + C.npc.Eden.pronoun + '.png'">
            <</if>>
        <!-- 原版未实装 -->
        <<case Sydney>>
            <<if $sydney.hair isnot "ponytail">>
                <<set _sydiconhair to "_lo">>
            <<else>>
                <<set _sydiconhair to "_po">>
            <</if>>
            <<if C.npc.Sydney.hairColour isnot "strawberryblond">>
                <<set _sydiconhairC to "bl">>
            <<else>>
                <<set _sydiconhairC to "st">>
            <</if>>
            <<if $sydney.glasses is "contacts">>
                <<set _sydiconglasses to "_co">>
            <<elseif $sydney.glasses is "broken" or $sydney.glasses is "playerbroken">>
                <<set _sydiconglasses to "_br">>
            <<else>>
                <<set _sydiconglasses to "_gl">>
            <</if>>
            <img class="icon infront" @src="'img/misc/icon/social/default/sydney/'+_sydiconhairC+_sydiconhair+_sydiconglasses+'.png'">
            <<if $wraith.state is "haunt">>
                <img class="icon" @src="'img/misc/icon/social/default/sydney/syd_iwr_' + _sydiconhairC + '.png'">
            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/sydney/syd_iwb_' + _sydiconhairC + '.png'">
            <</if>>
        <<case Morgan>>
            <<if $wraith.state is "haunt">>
                <img class="icon" @src="'img/misc/icon/social/default/morgan/morgan_iwr_' + C.npc.Morgan.pronoun + '.png'">
            <<else>>
                <img class="icon" @src="'img/misc/icon/social/default/morgan/morgan_iwb_' + C.npc.Morgan.pronoun + '.png'">
            <</if>>
    <</switch>>
<</if>>