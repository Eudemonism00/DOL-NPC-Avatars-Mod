:: NPCAvatarsMod_Cici
<<switch _npc>>
	<<case Whitney>>
		<img class="icon" src="img/misc/icon/social/cici/whitney/whitney.png">
	<<case Eden>>
        <<if C.npc.Eden.pronoun is "f">>
		    <img class="icon" src="img/misc/icon/social/cici/eden/eden_f.png">
        <</if>>
	<<case Mason>>
        <<if C.npc.Mason.pronoun is "f">>
		    <img class="icon" src="img/misc/icon/social/cici/mason/mason_f.png">
        <</if>>
<</switch>>

:: NPCAvatarsMod_Mimic_Cici
<<if $wraith.mimic isnot "">>
    <<switch $wraith.mimic>>
        /* 未来画了拟态图再补，没画直接自动用原版 */
        <<default>>
            <<include "NPCAvatarsMod_Mimic_Default">>
    <</switch>>
<</if>>